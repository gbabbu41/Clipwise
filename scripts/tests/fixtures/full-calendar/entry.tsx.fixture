import{useCalendarNavVisibility}from"../../../../src/lib/use-calendar-nav-visibility";
import React from 'react';import{createRoot}from'react-dom/client';import{CalendarView}from'../../../../src/components/calendar-view';import{SetupSheet}from'../../../../src/components/dashboard/setup-sheet';
function App(){const{navRef,hidden}=useCalendarNavVisibility(true);const[hours,setHours]=React.useState(false);return <div className="portal bg-background text-foreground flex flex-col" style={{height:'100dvh'}}><header className="shrink-0 flex items-center justify-between" style={{height:70,padding:'0 20px'}}><h1 style={{fontSize:24,fontWeight:700}}>Calendar</h1><button onClick={()=>setHours(true)}>Hours</button></header><main data-calendar-canvas className="flex-1 min-h-0 overflow-hidden"><CalendarView initialDate="2026-09-26" canManage canBlock pageTitle="Calendar" /></main><nav data-calendar-nav ref={navRef} data-calendar-nav-hidden={hidden||undefined} aria-hidden={hidden||undefined} aria-label="Mobile" className="cw-bnav lg:hidden">{['Home','Calendar','Checkout','More'].map(x=><button className="cw-ni" key={x}>{x}</button>)}</nav>{hours&&<SetupSheet step="hours" onClose={()=>setHours(false)}/>}</div>};createRoot(document.getElementById('root')!).render(<App/>);
