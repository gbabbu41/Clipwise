import React from 'react';import{createRoot}from'react-dom/client';import{CalendarView}from'../../../../src/components/calendar-view';import{SetupSheet}from'../../../../src/components/dashboard/setup-sheet';
function App(){const[hours,setHours]=React.useState(false);return <div className="portal bg-background text-foreground flex flex-col" style={{height:'100dvh'}}><header className="shrink-0 flex items-center justify-between" style={{height:70,padding:'0 20px'}}><h1 style={{fontSize:24,fontWeight:700}}>Calendar</h1><button onClick={()=>setHours(true)}>Hours</button></header><main className="flex-1 min-h-0 overflow-hidden"><CalendarView initialDate="2026-09-26" canManage canBlock pageTitle="Calendar" /></main><footer className="shrink-0 bg-card border-t border-border" style={{height:68,padding:18,display:'flex',justifyContent:'space-between'}}><span>Home</span><span>Calendar</span><button aria-label="Add appointment from navigation" onClick={()=>window.dispatchEvent(new Event('cw:calendar-add'))}>+</button><span>Checkout</span><span>More</span></footer>{hours&&<SetupSheet step="hours" onClose={()=>setHours(false)}/>}</div>};createRoot(document.getElementById('root')!).render(<App/>);
