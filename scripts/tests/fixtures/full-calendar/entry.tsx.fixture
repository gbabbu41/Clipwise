import{useMobileNavVisibility}from"../../../../src/lib/use-calendar-nav-visibility";
import React from 'react';import{createRoot}from'react-dom/client';import{CalendarView}from'../../../../src/components/calendar-view';import{SetupSheet}from'../../../../src/components/dashboard/setup-sheet';
function App(){const{navRef,hidden}=useMobileNavVisibility("/dashboard/calendar");const[hours,setHours]=React.useState(false);return <div className="portal bg-background text-foreground flex flex-col" style={{height:'100dvh'}}><header className="shrink-0 flex items-center justify-between" style={{height:70,padding:'0 20px'}}><h1 style={{fontSize:24,fontWeight:700}}>Calendar</h1><button onClick={()=>setHours(true)}>Hours</button></header><main data-calendar-canvas className="cw-main flex-1 min-h-0 overflow-hidden"><CalendarView initialDate="2026-09-26" canManage canBlock pageTitle="Calendar" /></main><nav data-scroll-nav ref={navRef} data-scroll-nav-hidden={hidden||undefined} aria-hidden={hidden||undefined} aria-label="Mobile" className="cw-bnav lg:hidden">{['Home','Calendar','Checkout','More'].map(x=><button className="cw-ni" key={x}>{x}</button>)}</nav>{hours&&<SetupSheet step="hours" onClose={()=>setHours(false)}/>}</div>};function NavAudit(){const[route,setRoute]=React.useState('/dashboard');const[nested,setNested]=React.useState(false);const{navRef,hidden}=useMobileNavVisibility(route);return <div className="portal bg-background text-foreground"><select aria-label="Route" style={{position:'fixed',top:0,zIndex:50}} value={route} onChange={e=>setRoute(e.target.value)}>{['/dashboard','/dashboard/checkout','/dashboard/payments','/dashboard/clients','/dashboard/settings','/barber-dashboard','/barber-dashboard/earnings','/barber-dashboard/clients'].map(x=><option key={x}>{x}</option>)}</select><button style={{position:'fixed',top:30,zIndex:50}} onClick={()=>setNested(v=>!v)}>Toggle nested</button><main className="cw-main" style={{paddingTop:80}}><div data-page-scroll className={nested?'overflow-y-auto':''} style={nested?{height:500}:{}}><div style={{height:1800}}>Page content</div></div><div role="dialog" style={{height:120,overflowY:'auto'}}><div style={{height:500}}>Dialog</div></div><div role="menu" style={{height:120,overflowY:'auto'}}><div style={{height:500}}>Menu</div></div><div data-horizontal style={{overflowX:'auto',height:70}}><div style={{width:1600}}>Horizontal carousel</div></div></main><nav ref={navRef} aria-label="Mobile" data-scroll-nav data-scroll-nav-hidden={hidden||undefined} aria-hidden={hidden||undefined} className="cw-bnav lg:hidden"><button className="cw-ni">Home</button><button className="cw-ni">More</button></nav></div>};createRoot(document.getElementById('root')!).render(location.search.includes('navAudit')?<NavAudit/>:<App/>);
