import React from 'react';import{createRoot}from'react-dom/client';import{StatsCarousel}from'../../../../src/components/dashboard/stats-carousel';
const statuses=['confirmed','completed','pending','no-show','cancelled'];function App(){const[scenario,setScenario]=React.useState('single');const[period,setPeriod]=React.useState('Today');const empty=scenario==='empty',multi=scenario==='multiple';const appointments=empty?[]:Array.from({length:multi?10:2},(_,i)=>({id:String(i),date:'2026-09-26',status:multi?statuses[i%5]:'confirmed'}));return <main className="portal bg-background text-foreground" style={{minHeight:'100vh',padding:16,maxWidth:900,margin:'auto'}}><h1 style={{fontSize:24,marginBottom:16}}>Home</h1><div style={{display:'flex',gap:8,marginBottom:16}}><select aria-label="Fixture data" value={scenario} onChange={e=>setScenario(e.target.value)}>{['single','empty','multiple'].map(x=><option key={x}>{x}</option>)}</select><select aria-label="Period" value={period} onChange={e=>setPeriod(e.target.value)}>{['Today','This month'].map(x=><option key={x}>{x}</option>)}</select></div><StatsCarousel revenue={empty?0:40.25} taxCollected={empty?0:5.25} cashIncluded={empty?0:40.25} netRevenue={empty?0:35} paidVisits={empty?0:1} appointments={appointments as any} completed={appointments.filter(a=>a.status==='completed') as any} topBarbers={empty?[]:multi?[{name:'Sourab',revenue:35},{name:'Alexandra Longname',revenue:25},{name:'Morgan',revenue:15}]:[{name:'Sourab',revenue:35}]} periodLabel={period} rangeStart={period==='Today'?'2026-09-26':'2026-09-01'} rangeEnd="2026-09-26" /></main>};createRoot(document.getElementById('root')!).render(<App/>);