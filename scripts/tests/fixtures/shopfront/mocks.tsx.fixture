export const useParams=()=>({shopslug:"fade-mechanic"});const search=new URLSearchParams(location.search);export const useSearchParams=()=>search;
const mode=new URLSearchParams(location.search).get('mode');
const shop={id:'shop',slug:'fade-mechanic',name:'Fade Mechanic',status:'approved',description:'Precision cuts. A little time for yourself.',address:'12 Example Street',city:'Halifax',province:'NS',phone:'9025550100',email:'hello+booking@example.test',instagram:'@fixture_studio',website:'fixture.example',facebook:'https://facebook.com/fixture',tiktok:'@fixture_studio',youtube:'@fixture_studio',subscription_plan:'pro',subscription_status:'active',stripe_connected:true,stripe_account_id:'acct_mock',allow_pay_in_person:true,booking_settings:{no_show_protection:true,pin_requires_card:false,auto_confirm:true}};
const barbers=[{id:'one',shop_id:'shop',name:'Alex',bio:'Cuts and careful finishes.',is_active:true,rating:4.9,total_reviews:12},{id:'two',shop_id:'shop',name:'Morgan',is_active:true,rating:4.8,total_reviews:9}];
const tables={shops:[shop],barbers,services:[{id:'cut',shop_id:'shop',name:'Signature cut',price:35,duration_minutes:30,category:'Hair',is_active:true},{id:'beard',shop_id:'shop',name:'Beard shape',price:15,duration_minutes:15,category:'Beard',is_active:true}],reviews:[],time_slots:barbers.flatMap(b=>Array.from({length:7},(_,day_of_week)=>({barber_id:b.id,day_of_week,start_time:'09:00:00',end_time:'19:00:00',is_available:true}))),time_off_requests:[]};
function query(table){let rows=[...(tables[table]||[])],single=false;const q=new Proxy({}, {get(_,key){if(key==='then')return(ok,bad)=>Promise.resolve({data:single?rows[0]||null:rows,error:null}).then(ok,bad);if(['insert','update','delete','upsert'].includes(key))return()=>{throw Error('No direct fixture writes')};return(...args)=>{if(key==='eq')rows=rows.filter(r=>r[args[0]]===args[1]);if(key==='single'||key==='maybeSingle')single=true;return q}}});return q}const channel={on(){return this},subscribe(){return this}};export const supabase={from:query,channel:()=>channel,removeChannel:()=>{}};
window.fixtureRequests=[];window.fixtureFailure=false;
window.fetch=async(url,init)=>{const body=JSON.parse(init?.body||'{}');window.fixtureRequests.push({url,body});let data={},ok=true;
if(url==='/api/availability')data={barbers:mode==='empty'?[]:barbers.map(b=>({...b,start_time:'09:00:00',end_time:'19:00:00',fullDayOff:false,busy:mode==='full'?[{time_slot:'9:00 AM',duration:600}]:[],blocked:[]}))};
else if(url==='/api/waitlist/join'){ok=!window.fixtureFailure;data=ok?{success:true}:{error:'Could not join waitlist — try again'};}
else if(url==='/api/book/in-person'){ok=!window.fixtureFailure;data=ok?{id:'mock-booking',status:'confirmed',barber_id:'one'}:{error:'That time was just booked. Please select another time.'};}
else if(url==='/api/stripe/booking-checkout'){ok=false;data={error:'Payment unavailable. Please try again.'};}
else if(url==='/api/stripe/booking-finalize'){ok=mode!=='failed';data=ok?{paid:true,appointmentId:'mock-paid',summary:{shopName:'Fade Mechanic',barberName:'Alex',serviceName:'Signature cut',date:'2026-10-05',time:'10:00 AM',total:35,clientEmail:'test@example.test'}}:{error:'Unable to confirm payment'};}
else if(url==='/api/clients/upsert')data={};else if(url==='/api/loyalty/lookup')data={points:0,value:0};else {ok=false;data={error:'Invalid code'};}return {ok,status:ok?200:409,json:async()=>data};};
