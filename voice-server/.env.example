# ClipWise voice server — copy to .env (or set these in your host's dashboard)

# Claude API key (Anthropic). Powers the phone conversation.
ANTHROPIC_API_KEY=sk-ant-...

# Your live app URL — where the availability/book endpoints live.
CLIPWISE_URL=https://clipwise.ca

# Shared secret. MUST be identical to AI_PHONE_SECRET set in Vercel.
AI_PHONE_SECRET=change-me-to-a-long-random-string

# Optional — the model. Default is the cheap, fast tier (best for voice).
# CLAUDE_MODEL=claude-haiku-4-5

# Optional — port the WebSocket server listens on.
# PORT=8080
